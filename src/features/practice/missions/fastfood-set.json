      "target": { "id": "set:single", "label": "단품을" },
      "action": { "type": "chooseSet", "set": false },
      "mistakes": [
        {
          "trigger": "set:set",
          "guide": {
            "title": "치즈버거는 단품이에요. 단품을 눌러 보세요",
            "detail": "세트는 담기지 않았어요"
          }
        }
      ]
    },
    {
      "id": "PB11",
      "screen": "burgerConfirm",
      "progress": { "stage": 3, "detail": "치즈버거 단품 담기 (3/3)" },
      "guide": {
        "title": "장바구니 담기를 눌러 보세요",
        "detail": "치즈버거 단품 1개가 맞는지 확인해요"
      },
      "target": { "id": "burger:addToCart", "label": "장바구니 담기를" },
      "action": { "type": "addDraftToCart" }
    },
    {
      "id": "PB12",
      "screen": "menu",
      "progress": { "stage": 4, "detail": "카드로 결제하기 (1/5)" },
      "guide": {
        "title": "주문 내역 확인 후 결제하기를 눌러 보세요",
        "detail": "버거 2개가 담겼어요"
      },
      "target": { "id": "menu:checkout", "label": "주문 내역 확인 후 결제하기를" }
    },
    {
      "id": "PB13",
      "screen": "orderReview",
      "progress": { "stage": 4, "detail": "카드로 결제하기 (2/5)" },
      "guide": { "title": "주문 내역을 확인하고 주문 확인을 눌러 보세요" },
      "target": { "id": "review:next", "label": "주문 확인을" }
    },
    {
      "id": "PB14",
      "screen": "paymentMethod",
      "progress": { "stage": 4, "detail": "카드로 결제하기 (3/5)" },
      "guide": { "title": "신용·체크카드를 눌러 보세요" },
      "target": { "id": "payment:card", "label": "신용·체크카드를" },
      "action": { "type": "selectPayment", "value": "card" }
    },
    {
      "id": "PB15",
      "screen": "cardInsert",
      "progress": { "stage": 4, "detail": "카드로 결제하기 (4/5)" },
      "guide": {
        "title": "카드를 넣었어요를 눌러 보세요",
        "detail": "실제로는 IC칩이 위로 가게 카드를 넣어요"
      },
      "target": { "id": "card:inserted", "label": "카드를 넣었어요를" },
      "action": { "type": "completePayment" }
    },
    {
      "id": "PB16",
      "screen": "paymentDone",
      "progress": { "stage": 4, "detail": "카드로 결제하기 (5/5)" },
      "guide": {
        "title": "주문번호를 확인하고 확인을 눌러 보세요",
        "detail": "화면에 이 번호가 뜨면 음식을 받아요"
      },
      "target": { "id": "done:confirm", "label": "확인을" }
